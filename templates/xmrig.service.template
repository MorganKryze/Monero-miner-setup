[Unit]
Description=XMRig Monero Miner
After=network.target

[Service]
Type=simple
User=%%USER%%
Group=%%GROUP%%
ConfigurationDirectory=xmrig
StateDirectory=xmrig/%%USER%%
StateDirectoryMode=0700
LogsDirectory=xmrig/%%USER%%
LogsDirectoryMode=0750
WorkingDirectory=/var/lib/xmrig/%%USER%%
ExecStartPre=/bin/sh -c 'cmp -s /etc/xmrig/config.json /var/lib/xmrig/%%USER%%/seed.json || { cp /etc/xmrig/config.json /var/lib/xmrig/%%USER%%/config.json.new && mv -f /var/lib/xmrig/%%USER%%/config.json.new /var/lib/xmrig/%%USER%%/config.json && cp /etc/xmrig/config.json /var/lib/xmrig/%%USER%%/seed.json; }'
# Names where the binary comes from and the donate level it starts with; never blocks the start.
ExecStartPre=-/bin/sh -c 'h=$$(sha256sum < "$$1/xmrig" | cut -c1-64); d=$$(grep -o "donate-level.: *[0-9]*" "$$2" | grep -o "[0-9]*$$"); if [ ! -e "$$1/xmrig.release" ]; then o="compiled on this host"; elif r=$$(cat "$$1/xmrig.release") && [ -n "$$h" ] && [ "$${r#* }" = "$$h" ]; then o="release $$(echo "$$r" | cut -d" " -f1), sha256 $$h"; else o="unknown (sha256 $${h:-unreadable} matches no release record)"; fi; echo "Miner binary: $$o; donate level $${d:-unknown}"' miner-origin %%WORKING_DIR%% /var/lib/xmrig/%%USER%%/config.json
ExecStart=%%WORKING_DIR%%/xmrig --config=/var/lib/xmrig/%%USER%%/config.json --log-file=/var/log/xmrig/%%USER%%/xmrig.log
Restart=on-failure
RestartSec=15
Nice=10

[Install]
WantedBy=multi-user.target